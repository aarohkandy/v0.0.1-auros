# AurOS Theme — Light (id sandstone). THE DEFAULT, on every surface.
# "Sky": white cards on a soft colour-field sky, black ink, each program
# its own colour tile, one green that always means "this way".
# Tokens: docs/DESIGN-DIRECTION.md §3 "Colour: Light". Every pair is
# checked by tools/contrast.c --strict, rules included.
inherit="nocturne"

theme_name="Light"
theme_variant="light"
theme_description="Dark writing on white, under a soft sky."

bg="#F5F7FA"         # paper: page, desktop
bg_alt="#FAFBFC"     # soft: bars, alternate sections
surface="#FFFFFF"    # card: windows, menus, dialogs
surface_hi="#E1ECE7" # selected: the chosen row or card only
overlay="#687079"    # rule: every border and outline (4.7:1 or more)
muted="#464A51"      # quiet: hints and legal lines (7:1 or more, painted at full strength)
subtle="#33363B"     # ink-2: secondary text (7:1 or more even at the shell's 85%)
fg="#17181A"         # ink: everything she reads or acts on
fg_hi="#17181A"

accent="#0B5D4F"       # go: the way forward, and what she chose
accent_alt="#3A3D42"
accent_warm="#07463B"  # go, pressed
ok="#0B5D4F"  warn="#8A5A12"  err="#9E2B22"  info="#3A3D42"

ansi0="#17181A"  ansi8="#5C6066"
ansi1="#9E2B22"  ansi9="#B5392F"
ansi2="#0B5D4F"  ansi10="#137565"
ansi3="#8A5A12"  ansi11="#946318"
ansi4="#2F5A8A"  ansi12="#3D6FA6"
ansi5="#6E4A78"  ansi13="#835C8E"
ansi6="#1F6C6A"  ansi14="#267875"
ansi7="#F5F7FA"  ansi15="#FFFFFF"

# Round, roomy shapes: the corners match the fills they edge.
radius="22"  radius_sm="14"  gap="16"  margin="20"  padding="22"  bar_height="52"

# Each program its own colour tile, its mark in white.
icon_tiles="1"

# A soft sky: three pale washes on near-white, nothing printed on it.
wall_style="mesh"
wall_c1="#EEF3F8"  wall_c2="#B9E0F2"  wall_c3="#C8EEDF"  wall_c4="#E2D9F6"
wall_intensity="0.85"  wall_grain="0"  wall_vignette="0"
