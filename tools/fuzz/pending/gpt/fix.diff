 /* Parse one header block. 0 on success. */
-static int parse_header(const uint8_t *h, uint32_t sector, gpt_table *t)
+static int parse_header(const uint8_t *h, uint32_t sector, uint64_t at_lba,
+                        gpt_table *t)
 {
     if (memcmp(h, "EFI PART", 8) != 0) return -1;
 
@@ -128,7 +129,22 @@
         t->entry_size % 8 || t->n_entries == 0 ||
         t->n_entries > GPT_MAX_ENT)
         return -1;
-    if (t->entry_lba < 2 && t->my_lba == 1) return -1;
+    /* UEFI's own validity checks (2.10, 5.3.2), which a header with a
+     * good CRC can still fail. It must say where it is; describe only
+     * space this disk has; and keep its entry array out of the space it
+     * describes. A table that breaks one of these is a disk cloned onto
+     * a smaller one, or one somebody built by hand -- and what this
+     * program would do with it is write the new array where the header
+     * points, which is then inside a partition or on top of the
+     * protective MBR. Found by tools/fuzz/fuzz_gpt.c. */
+    uint64_t arr_secs = ((uint64_t)t->n_entries * t->entry_size + sector - 1) / sector;
+    if (t->my_lba != at_lba) return -1;
+    if (t->first_usable < 2 || t->first_usable > t->last_usable ||
+        t->last_usable >= t->disk_sectors) return -1;
+    if (t->entry_lba < 2 || t->entry_lba >= t->disk_sectors ||
+        arr_secs > t->disk_sectors - t->entry_lba) return -1;
+    if (t->entry_lba <= t->last_usable && t->entry_lba + arr_secs > t->first_usable)
+        return -1;
     return 0;
 }
 
