#!/bin/sh
# TEST ONLY. Copied onto the seed partition by `plan.py --test-hooks`, never
# by the product. Reports to the VM's serial port and switches the machine
# off once the desktop session has started, so a harness outside can tell
# what happened without a network or a person.
here=/run/othersys/lib/test
case $1 in
hold)
    # powercut variant, first of late-commands: the installer is done and
    # has put Ubuntu first; wait for the guard to put Windows back, say so
    # with its log, and stop here for the harness to pull the plug
    n=0
    until grep -q 'guard: Boot' /run/othersys/log 2>/dev/null || [ $n -ge 30 ]; do
        sleep 1
        n=$((n + 1))
    done
    {
        echo "OTHERSYS-TEST HOLD-LOG-BEGIN"
        cat /run/othersys/log
        echo "OTHERSYS-TEST LATE-HELD $(date -u +%s)"
    } > /dev/ttyS0 2>&1
    sleep 3600
    ;;
late)
    t=$2
    install -D -m755 $here/report "$t/usr/lib/auros-othersys-test/report"
    for u in othersys-test.service othersys-test-session.path othersys-test-session.service; do
        install -D -m644 $here/$u "$t/etc/systemd/system/$u"
    done
    mkdir -p "$t/etc/systemd/system/multi-user.target.wants" "$t/etc/systemd/system/paths.target.wants"
    ln -sf /etc/systemd/system/othersys-test.service "$t/etc/systemd/system/multi-user.target.wants/"
    ln -sf /etc/systemd/system/othersys-test-session.path "$t/etc/systemd/system/paths.target.wants/"
    install -D -m644 $here/zz-othersys-test.desktop "$t/etc/xdg/autostart/zz-othersys-test.desktop"
    {
        echo "OTHERSYS-TEST LATE-LOG-BEGIN"
        cat /run/othersys/log
        echo "OTHERSYS-TEST LATE-LOG-END"
        echo "OTHERSYS-TEST LATE-DONE $(date -u +%s)"
    } > /dev/ttyS0 2>&1
    ;;
error)
    {
        echo "OTHERSYS-TEST INSTALL-ERROR $(date -u +%s)"
        cat /run/othersys/log 2>/dev/null
        for f in $(find /var/log/installer -maxdepth 2 -type f -name '*.log' 2>/dev/null); do
            echo "==== $f"; tail -n 150 "$f"
        done
    } > /dev/ttyS0 2>&1
    ;;
esac
exit 0
