#!/bin/sh
# ═══════════════════════════════════════════════════════════════════
#  local-top/auros-lock — open AurOS's encrypted partition at start
#  (docs/security/THEFT.md). Installed (as a COPY: update-initramfs
#  copies scripts/ as it finds them, and a link would dangle) into
#  /etc/initramfs-tools/scripts/ by `lockctl prepare`; inert without
#  auros.lock= on the command line, which only the menu on the EFI
#  partition (lockctl boot-sync) has.
#
#  A plain partition is encrypted in place first (encrypt-init). Then
#  aurlock-pin opens it: silently while the temporary key still works,
#  otherwise with the PIN page. If the page cannot run at all, the
#  plain cryptsetup prompt does the same job: never a dead end.
#
#  Everything is traced to /run/auros-lock.log, which the started
#  system keeps, because a failure in here is otherwise invisible
#  (measured: tools/theftvm.sh).
# ═══════════════════════════════════════════════════════════════════
PREREQ=""
prereqs() { echo "$PREREQ"; }
case "${1:-}" in prereqs) prereqs; exit 0 ;; esac

LOCK=""
for x in $(cat /proc/cmdline); do
    case "$x" in auros.lock=PARTUUID=*) LOCK=${x#auros.lock=PARTUUID=} ;; esac
done
[ -n "$LOCK" ] || exit 0

L=/usr/lib/auros/lock
LOG=/run/auros-lock.log
echo "auros-lock: start, partition $LOCK" >> "$LOG"
note() { echo "auros-lock: $*" >> "$LOG"; echo "auros-lock: $*" > /dev/console 2>/dev/null; }
mkdir -p /run/cryptsetup
# Without device-mapper's udev rules in this initramfs, libdevmapper
# would wait for a udev answer that never comes: it makes the node itself.
export DM_DISABLE_UDEV=1
# The page also writes to /dev/console itself (see lockpin.c, diag()).
export AURLOCK_CONSOLE=1
# evdev: the page reads the keyboard through it (built in on Ubuntu's
# kernel today; a module tomorrow would be a page nobody can type into)
for m in dm_mod dm_zero dm_crypt xts aesni_intel adiantum nhpoly1305 chacha_generic tpm_crb tpm_tis evdev; do
    modprobe -q "$m" >> "$LOG" 2>&1
done

DEV=/dev/disk/by-partuuid/$LOCK
i=0
while [ ! -b "$DEV" ] && [ "$i" -lt 300 ]; do sleep 0.1; i=$((i + 1)); done
if [ ! -b "$DEV" ]; then
    note "partition $LOCK did not appear"
    exit 0
fi

if ! cryptsetup isLuks "$DEV" >> "$LOG" 2>&1; then
    note "the partition is plain: encrypting it in place"
    "$L/encrypt-init" "$DEV" >> "$LOG" 2>&1
    rc=$?
    # 0 encrypted; 2 encrypted, but the header disagrees with what was
    # asked (it opens all the same); anything else: refused, and the
    # partition is still plain, so start it plain.
    if [ "$rc" != 0 ] && [ "$rc" != 2 ]; then
        note "not encrypted (see /run/auros-lock.log in the started system); starting plain"
        tail -n 5 "$LOG" > /dev/console 2>/dev/null
        exit 0
    fi
    [ "$rc" = 2 ] && note "WARNING: encrypted, but the header is not what was asked for"
fi

n=0
while [ ! -b /dev/mapper/auros-root ] && [ "$n" -lt 3 ]; do
    note "opening the drive (attempt $((n + 1)))"
    "$L/aurlock-pin" "$DEV" auros-root 2>> "$LOG"
    n=$((n + 1))
done
while [ ! -b /dev/mapper/auros-root ]; do
    note "the page could not open the drive: plain prompt"
    cryptsetup open --allow-discards "$DEV" auros-root
done
note "open: /dev/mapper/auros-root"
echo "ROOT=/dev/mapper/auros-root" >> /conf/param.conf
exit 0
