# Generated by auros-bootchain from /usr/lib/auros/grub.cfg.in.
# update-grub on AurOS IS auros-bootchain: edit the template, not this.
set default=0
set timeout=3
set timeout_style=menu

insmod part_gpt
insmod ext2
insmod search_fs_uuid

search --no-floppy --fs-uuid --set=root @ROOT_UUID@

# THE FIRMWARE'S OWN TEXT CONSOLE, NOT gfxterm.
#
# This used to `loadfont /boot/grub/fonts/unicode.pf2` and switch to
# gfxterm. Canonical's signed grub refuses loadfont under Secure Boot
# (fonts are unsigned files, and a font parser was CVE-2022-2601), so
# every start printed "error: prohibited by secure boot policy" and the
# menu fell back to grub's built-in ASCII font: the frame drawn in
# question marks, the arrow-key hint as "?". The firmware console draws
# with the firmware's own font, works with Secure Boot on, and keeps the
# menu on the serial line where the tests can read it. Found by
# tools/bootupdatetest.sh; screenshots of both in docs/results/.
serial --unit=0 --speed=115200
terminal_input  console serial
terminal_output console serial

# THE MENU IS LOCKED: NOBODY EDITS A START LINE, OPENS GRUB'S COMMAND LINE,
# OR PICKS A ROOT SHELL WITHOUT A PASSWORD, AND NOBODY KNOWS IT.
#
# Anyone at the keyboard of a PC that starts AurOS used to get GRUB's menu
# and, with `e`, the start line: add init=/bin/bash and the machine opens
# a root shell, past her login and past her disk encryption's PIN, in
# thirty seconds (the recovery-shell entry did it with one more key).
# `superusers` makes `e`, `c` and every entry not marked --unrestricted
# ask for a name and password. The password is 32 random bytes made on
# this machine by auros-bootchain and thrown away; only its PBKDF2 hash is
# kept (var/lib/auros/grub-lock), so there is no password to find, to
# write down or to be told. Starting AurOS, the kernel before it, Windows
# and Put Windows back never ask: they are --unrestricted below.
# tools/bootlocktest.sh boots the image and presses the keys.
@GRUBLOCK@
@THEME@

# ONE START CHOSEN FROM INSIDE AUROS, and only one. "Put Windows back"
# in AurOS writes next_entry here (rootfs/usr/lib/auros/answer.sh) and
# restarts; it is cleared before the entry runs, so a restore that
# stops -- or a power cut -- does not come round again at the next
# start. aurstage_extra is for tools/putbacktest.sh and nothing else:
# it adds a serial console to the restore so the test can read it.
if [ -s ($root)/boot/grub/grubenv ]; then
  load_env --file ($root)/boot/grub/grubenv next_entry auros_asked auros_win auros_try auros_bad aurstage_extra auros_handover
  export aurstage_extra
fi
@FALLBACK@
# A REQUEST THAT SAYS WHEN IT WAS MADE, AND ONLY THAT. answer.sh writes
# the hardware clock's reading beside next_entry as auros_asked; it goes
# to the restore as aurstage.asked=, and the restore will not run one
# more than an hour old (src/aurstage/main.c). grub has no clock, and a
# next_entry the firmware never acted on -- it started Windows instead
# -- would otherwise remove AurOS weeks later at whatever start next
# reached this menu. A next_entry WITHOUT a time is not ours to trust
# and is dropped. Chosen by hand from the menu, the restore gets an
# empty aurstage.asked=: somebody at the keyboard now is fresh.
if [ "${next_entry}" ]; then
  set auros_ho=
  if [ "${auros_asked}" ]; then
    # Her AurOS files, left for Windows (handover.sh): where on the disk, how many blocks,
    # and the SHA-256 of them. Handed to THIS restore only, and used up with the request,
    # like next_entry: a restore chosen by hand later gets none, and a record left behind
    # would describe a volume AurOS may have changed since.
    set auros_ho="${auros_handover}"
    set default="${next_entry}"
    # No fallback for this one start: if the restore cannot be started,
    # starting AurOS instead -- silently, with next_entry already used
    # up -- would leave the person who asked for Windows back in AurOS
    # with no idea why. The menu stays up instead.
    unset fallback
    # TEN SECONDS WITH IT ON SCREEN, not three: a visible moment to
    # press a key and choose otherwise.
    set timeout=10
    set timeout_style=menu
  fi
  set auros_req="${auros_asked}"
  export auros_req
  export auros_ho
  set next_entry=
  set auros_asked=
  set auros_handover=
  save_env --file ($root)/boot/grub/grubenv next_entry auros_asked auros_handover
fi

# AUROS ALWAYS STARTS: BOOT COUNTING, AND THE KERNEL BEFORE.
#
# auros_try counts starts of an AurOS kernel that nothing confirmed. Each
# AurOS entry below adds one as it runs (auros_count); auros-boot-ok
# (a service, once the desktop has been up two minutes) removes it.
# So a start that got as far as a working desktop leaves it empty, and a
# start that panicked, hung or looped leaves it where it was -- and the
# next start can tell.
#
#   empty or 1  the newest kernel (a start cut short is not a verdict)
#   2 or more   two starts in a row were never confirmed: the kernel
#               before it, and the newest is remembered as bad in
#               auros_bad. That stays until a different newest kernel
#               arrives (this file is written again for it), so a kernel
#               that panics costs two restarts, once, and not two every
#               few days. auros-boot-ok forgets it if the newest is ever
#               confirmed anyway (started by hand from this menu).
#
# Only when there is a kernel before (auros_prev, written by
# auros-bootchain next to `fallback`), and never for the restore: that
# one is a request, not a start of AurOS. tools/rollbacktest.sh boots a
# kernel that panics, and a mutant with the counting removed.
function auros_count {
  if [ -z "${auros_try}" ]; then
    set auros_try=1
  elif [ "${auros_try}" = 1 ]; then
    set auros_try=2
  elif [ "${auros_try}" = 2 ]; then
    set auros_try=3
  else
    set auros_try=4
  fi
  save_env --file ($root)/boot/grub/grubenv auros_try
}
if [ -z "${auros_req}" ]; then
  if [ "${auros_prev}" ]; then
    if [ "${auros_try}" = 2 -o "${auros_try}" = 3 -o "${auros_try}" = 4 ]; then
      set auros_bad=@KVER@
      save_env --file ($root)/boot/grub/grubenv auros_bad
    fi
    if [ "${auros_bad}" = "@KVER@" ]; then
      set default=auros-previous
    fi
  fi
fi

# THE KERNEL'S OWN HARDENING, on every AurOS line below and on the
# previous-kernel line auros-bootchain writes (keep the two the same;
# tools/hardentest.sh checks both). docs/security/HARDENING.md has the
# cost of each:
#   init_on_alloc=1 slab_nomerge randomize_kstack_offset=on
#                  memory the kernel hands out is zeroed, kernel objects
#                  of different kinds never share a slab, and the kernel
#                  stack moves on every system call
#   vsyscall=none  no fixed-address code page for exploits to jump to
#   debugfs=off    the kernel's debugging filesystem does not exist
#   panic=10       a panic restarts the computer instead of freezing it
#   fsck.repair=yes  a damaged disk is repaired at start without asking,
#                  instead of stopping at "requires a manual fsck"
#   lockdown=integrity  nothing running as root can change the running
#                  kernel (unsigned modules, /dev/mem, kexec, MSR writes,
#                  hibernation images). Secure Boot already turns this
#                  on; the option keeps it on for a PC that has Secure
#                  Boot switched off. Costs nothing.
# NOT init_on_free=1: it costs several per cent on every free, for a
# protection init_on_alloc already mostly gives.
menuentry 'AurOS' --class auros --unrestricted --id auros {
    linux  /boot/vmlinuz-@KVER@ root=UUID=@ROOT_UUID@ ro quiet splash console=tty0 console=ttyS0,115200n8 init_on_alloc=1 slab_nomerge randomize_kstack_offset=on vsyscall=none debugfs=off panic=10 fsck.repair=yes lockdown=integrity
    initrd /boot/initrd.img-@KVER@
    auros_count
}

menuentry 'AurOS (verbose boot)' --class auros --unrestricted --id auros-verbose {
    linux  /boot/vmlinuz-@KVER@ root=UUID=@ROOT_UUID@ ro console=tty0 console=ttyS0,115200n8 systemd.show_status=1 init_on_alloc=1 slab_nomerge randomize_kstack_offset=on vsyscall=none debugfs=off panic=10 fsck.repair=yes lockdown=integrity
    initrd /boot/initrd.img-@KVER@
    auros_count
}

# (There used to be a "recovery shell" entry here: single init=/bin/bash,
# a root shell for anyone who pressed the arrow keys. Nothing needed it
# that the menu's lock does not already keep for someone who has the
# password, and nobody has.)
#
# aurinit is AurOS's own PID 1. It supervises our service model; the
# Ubuntu userland in this image still expects systemd, so this entry is
# for appliance and kiosk builds where the service set is entirely ours.
menuentry 'AurOS (aurinit, experimental)' --class auros --id auros-aurinit {
    linux  /boot/vmlinuz-@KVER@ root=UUID=@ROOT_UUID@ ro init=/usr/sbin/aurinit console=tty0 console=ttyS0,115200n8 init_on_alloc=1 slab_nomerge randomize_kstack_offset=on vsyscall=none debugfs=off panic=10 fsck.repair=yes lockdown=integrity
    initrd /boot/initrd.img-@KVER@
}
@PREVIOUS@
# WINDOWS, WHEN THERE IS ONE, AND NOTHING WHEN THERE IS NOT.
#
# AurOS installs alongside Windows and does not remove it, so after
# phase 10 makes AurOS the default this is the only way back to it that
# does not involve a firmware key nobody remembers. It is found rather
# than configured: "search --file" looks for the Windows boot manager
# on every partition the firmware can see, which needs no knowledge of
# the machine at build time -- and the whole entry is inside the "if",
# so an image booted on a computer with no Windows on it does not
# offer a menu line that fails when chosen.
#
# STARTED BY THE FIRMWARE, NOT BY THIS MENU. Chainloading bootmgfw.efi
# from here put shim, grub and Microsoft's third-party CA into the TPM
# where BitLocker expects only Windows Boot Manager, and a BitLocker PC
# stopped at its recovery-key screen. So this starts a few seconds of
# AurOS (/usr/lib/auros/start-windows) that tells the firmware to start
# Windows Boot Manager next, and restarts: the firmware starts Windows
# the way it does every other morning. tools/windowsboottest.sh
# compares the TPM's PCR 4 and 7 both ways.
if search --no-floppy --file --set=winesp /EFI/Microsoft/Boot/bootmgfw.efi ; then
menuentry 'Windows' --class windows --unrestricted --id windows {
    linux  /boot/vmlinuz-@KVER@ root=UUID=@ROOT_UUID@ ro quiet init=/usr/lib/auros/start-windows console=tty0 console=ttyS0,115200n8 init_on_alloc=1 slab_nomerge randomize_kstack_offset=on vsyscall=none debugfs=off panic=10 fsck.repair=yes lockdown=integrity
    initrd /boot/initrd.img-@KVER@
}
fi

# WINDOWS THE OLD WAY, ONCE: only when start-windows could not ask the
# firmware (no Windows Boot Manager entry, a start-up store that would
# not be written) AND, in Linux, found no BitLocker volume on any
# partition (it reads their first sectors; this menu cannot read an
# encrypted or NTFS drive reliably, so the decision is not remade here).
# It is asked for with auros_win=chain, used up at once, and is a start
# of Windows chosen for her by the menu -- which is what she asked for.
# Otherwise nothing happens and AurOS starts as usual.
if [ "${auros_win}" = chain ]; then
  set auros_win=
  save_env --file ($root)/boot/grub/grubenv auros_win
  menuentry 'Windows' --class windows --unrestricted --id windows-chain {
      insmod part_gpt
      insmod fat
      insmod chain
      search --no-floppy --file --set=root /EFI/Microsoft/Boot/bootmgfw.efi
      chainloader /EFI/Microsoft/Boot/bootmgfw.efi
  }
  set default=windows-chain
  set timeout=0
fi

# PUT WINDOWS BACK: REMOVE AUROS AND GIVE WINDOWS ITS SPACE BACK.
#
# The restore is the staging environment's (aurstage.restore), started
# from the kernel the installer left in \EFI\AurOS on the machine's own
# EFI partition -- the same Canonical-signed kernel the install ran on,
# so it starts with Secure Boot on. It is here, in AurOS's own menu, so
# that it can be reached when AurOS itself no longer starts; AurOS's
# Settings reach it too, by choosing it for the next start.
#
# Behind a question, because one key in a menu should not remove an
# operating system: "No" comes first and is what Enter does. The whole
# thing is inside the if, so a machine whose installer files are gone
# has no line that fails when chosen.
if search --no-floppy --file --set=aurstage /EFI/AurOS/staging.efi ; then
submenu 'Put Windows back (remove AurOS)' --class windows --unrestricted --id put-windows-back {
    menuentry 'No, keep AurOS' --unrestricted --id put-windows-back-no {
        configfile /boot/grub/grub.cfg
    }
    menuentry 'Yes: remove AurOS and give Windows all of its drive back' --class windows --unrestricted --id put-windows-back-yes {
        insmod part_gpt
        insmod fat
        search --no-floppy --file --set=root /EFI/AurOS/staging.efi
        linux  /EFI/AurOS/staging.efi aurstage.restore aurstage.asked=${auros_req} aurstage.handover=${auros_ho} console=tty0 gpt quiet loglevel=3 ${aurstage_extra}
        initrd /EFI/AurOS/staging.img
    }
}
fi
