#!/bin/sh
# DPkg::Post-Invoke (apt.conf.d/53auros-updates): when apt has moved
# AurOS's own packages forward, keep the set that was installed before,
# so that an update which breaks the desktop can be undone
# (/usr/lib/auros/rollback). docs/security/UPDATES.md
#
#   /var/lib/auros/debs           the set installed now, when this knew
#                                 where to find it (the image's own at
#                                 first; build/aptchannel put it there)
#   /var/lib/auros/debs-previous  the set that was installed before the
#                                 last update
#
# The set that was installed until a moment ago IS the rollback target
# and is already on this disk, so the move to debs-previous needs
# nothing from the network or from apt's cache. Only filling debs/ with
# the NEW set (the next update's rollback target) takes the .debs from
# apt's cache, all of them or none.
#
# Runs after every apt-driven dpkg run, so it is one dpkg-query when
# nothing of AurOS's changed. Never fails: it must not fail an update.
set -u
D=${AUROS_DEBS:-/var/lib/auros/debs}
P=$D-previous
C=${AUROS_APT_CACHE:-/var/cache/apt/archives}
ver_of() { ls "$1"/auros_*_amd64.deb 2>/dev/null | head -1 | sed 's#.*/auros_\(.*\)_amd64\.deb$#\1#'; }
cur=$(dpkg-query -W -f='${Version}' auros 2>/dev/null) || exit 0
[ -n "$cur" ] || exit 0
have=$(ver_of "$D")
[ "$cur" != "$have" ] || exit 0
# Forward only: a rollback moves the sets itself. (No set at all, as
# after an update that found nothing in the cache, is not an obstacle.)
if [ -n "$have" ]; then dpkg --compare-versions "$cur" gt "$have" || exit 0; fi
# Every part must be at the new version (a later dpkg run of the same
# update has not finished otherwise).
parts=$(dpkg-query -W -f='${db:Status-Abbrev} ${Package} ${Version}\n' 'auros' 'auros-*' 2>/dev/null | awk '$1=="ii"{print $2 "=" $3}')
for pv in $parts; do [ "${pv#*=}" = "$cur" ] || exit 0; done
new=$(mktemp -d "$D.new.XXXXXX") || exit 0
for pv in $parts; do
    p=${pv%%=*}
    f="$C/${p}_$(printf '%s' "$cur" | sed 's/:/%3a/')_amd64.deb"
    if [ -f "$f" ]; then cp "$f" "$new/" || { rm -rf "$new"; mkdir -p "$new"; break; }
    else rm -rf "$new"; mkdir -p "$new"; break; fi
done
[ -n "$(ls "$new" 2>/dev/null)" ] && ( cd "$new" && sha256sum ./*.deb > SHA256SUMS )
if [ -n "$have" ]; then rm -rf "$P" && mv "$D" "$P"; else rm -rf "$D"; fi
mv "$new" "$D"
exit 0
